pkgname=chuhshell
pkgver=0.1.0
pkgrel=1
pkgdesc='Integrated desktop shell for Niri'
arch=('x86_64' 'aarch64')
url='https://github.com/chuh420/chuhshell'
license=('LicenseRef-unlicensed')
depends=('gtk4' 'gtk4-layer-shell' 'glib2>=2.80' 'niri' 'wireplumber' 'libpulse' 'networkmanager' 'brightnessctl' 'systemd' 'bluez' 'wl-clipboard' 'curl' 'ttf-dejavu' 'ttf-nerd-fonts-symbols-mono')
makedepends=('cargo' 'git')
optdepends=('power-profiles-daemon: battery power profiles' 'ttf-input: optional unpatched input text font')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SOURCE_ARCHIVE_CHECKSUM')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked --offline
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --locked --offline
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "${CARGO_TARGET_DIR:-target}/release/chuhshell" "$pkgdir/usr/bin/chuhshell"
    install -Dm644 packaging/chuhshell.service "$pkgdir/usr/lib/systemd/user/chuhshell.service"
    install -Dm644 packaging/org.freedesktop.Notifications.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.Notifications.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/chuhshell/README.md"
}
