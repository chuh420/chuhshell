pkgname=chuhshell
pkgver=0.1.0
pkgrel=1
pkgdesc='Integrated desktop shell for Niri'
arch=('x86_64' 'aarch64')
url='https://github.com/chuh420/chuhshell'
license=('LicenseRef-unlicensed')
depends=('gtk4' 'gtk4-layer-shell' 'glib2>=2.80' 'niri' 'wireplumber' 'libpulse' 'networkmanager' 'brightnessctl' 'systemd')
makedepends=('cargo' 'git')
optdepends=('foot: terminal for network and process tools' 'btop: process tool' 'ttf-input: interface font')
source=()
sha256sums=()

prepare() {
    cd "$startdir/.."
    cargo fetch --locked
}

build() {
    cd "$startdir/.."
    cargo build --release --locked
}

check() {
    cd "$startdir/.."
    cargo test --locked
}

package() {
    cd "$startdir/.."
    install -Dm755 target/release/chuhshell "$pkgdir/usr/bin/chuhshell"
    install -Dm644 packaging/chuhshell.service "$pkgdir/usr/lib/systemd/user/chuhshell.service"
    install -Dm644 packaging/org.freedesktop.Notifications.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.Notifications.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/chuhshell/README.md"
}
