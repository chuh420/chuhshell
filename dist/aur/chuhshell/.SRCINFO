pkgbase = chuhshell
	pkgdesc = A Wayland desktop shell for Hyprland, niri and sway
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/chuh420/chuhshell
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	license = OFL-1.1
	makedepends = cargo
	makedepends = clang
	depends = gcc-libs
	depends = glibc
	depends = libpipewire
	depends = libxkbcommon
	depends = ttf-font
	depends = wireplumber
	optdepends = upower: battery chip and panel
	optdepends = power-profiles-daemon: power profiles
	optdepends = iwd: Wi-Fi panel
	optdepends = networkmanager: Wi-Fi panel
	optdepends = bluez: Bluetooth panel
	optdepends = brightnessctl: brightness slider and keys
	optdepends = cliphist: clipboard panel
	optdepends = wl-clipboard: clipboard panel and screenshots
	optdepends = imagemagick: wallpaper previews
	optdepends = ffmpeg: posters for live wallpapers
	optdepends = mpvpaper: live wallpapers
	optdepends = matugen: colors from the wallpaper
	optdepends = hyprlock: lock screen on Hyprland
	optdepends = swaylock: lock screen on sway and niri
	optdepends = grim: screenshots
	optdepends = slurp: screenshots of a region
	optdepends = pavucontrol: the default mixer
	optdepends = ttf-jetbrains-mono-nerd: default icon font
	optdepends = adwaita-fonts: default interface font
	options = !lto
	options = !debug
	source = chuhshell-0.1.0.tar.gz::https://github.com/chuh420/chuhshell/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = 3680233834b461cb1718944858e1f7e5366b6f50e28398780e28dcaf050953d6

pkgname = chuhshell
